NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_SECRET_KEY=strong_secret_key

# Email through Zoho (lib/email). The send mail token from Zoho's dashboard, with or without the
# "Zoho-enczapikey" prefix. Leave empty locally to print emails to the console instead of sending.
ZOHO_API_KEY=
EMAIL_FROM=poxeet@klosapoint.com
EMAIL_FROM_NAME=Poxeet
# Optional: the address the Privacy page gives for data and account requests. Defaults to EMAIL_FROM.
# CONTACT_EMAIL=
# Optional: where replies go.
# EMAIL_REPLY_TO=
# Optional: only if your Zoho account uses a different API host.
# ZOHO_EMAIL_URL=https://cpaas.zoho.com/v1.1/email

# LinkedIn app (Developer Portal): products "Share on LinkedIn" and "Sign In with LinkedIn using OpenID Connect".
# Register the redirect URL on the app: http://localhost:3000/api/linkedin/callback locally, and
# https://<your domain>/api/linkedin/callback in production. LINKEDIN_REDIRECT_URI overrides the default
# (<this site>/api/linkedin/callback) when the app runs behind a proxy.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# LINKEDIN_REDIRECT_URI=

# Encrypts members' AI keys and LinkedIn tokens at rest (lib/crypto.ts): 32 random bytes, base64. Generate one with
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Changing it makes saved keys unreadable; members would need to add them again.
ENCRYPTION_KEY=

# The admin area (D-032): keys the hashes of admins' access codes and signs the 12-hour admin session. 32+
# characters, server only; the admin area stays closed until it's set. Same command as above to make one.
# Changing it invalidates every admin's access code: run `pnpm admin:create` to set a new one.
ADMIN_SECRET=

# AI. Members can bring their own Claude, OpenAI or DeepSeek key. Optionally, the operator's shared key for
# members granted master-key access: AI_PROVIDER picks which of the keys below it uses.
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
# Optional model overrides. Defaults: claude-opus-5-5 and deepseek-flash; OpenAI has no default yet.
# MODEL_ANTHROPIC=
# MODEL_OPENAI=
# MODEL_DEEPSEEK=

# The public address of this instance, for links in emails and Bachs checkout return links. Bachs refuses
# localhost: to test payments locally, run a tunnel (cloudflared tunnel --url http://localhost:3000), put its URL here
# and open the app through it.
APP_URL=http://localhost:3000

# Billing (D-022): members buy AI credits to use the shared key above. Off unless BILLING_ENABLED=true; when off,
# no billing route, page or check runs and nothing below is needed. A sk_sandbox_ key uses Bachs' sandbox.
# Register <APP_URL>/api/billing/webhook in the Bachs dashboard for collection.succeeded and refund.paid.
# Packs live in the credit_packs table (defaults added by migration 202610150006); no Bachs products are needed.
# Change them with `pnpm packs list|add|edit`.
# BILLING_ENABLED=true
# BACHS_API_KEY=sk_sandbox_
# BACHS_WEBHOOK_SECRET=
# Optional: BACHS_API_URL (defaults from the key), CREDIT_MARGIN (default 6, over Sonnet's price), STARTER_CREDITS (default 50, 0 for none).
# Naira (D-033): visitors in Nigeria see and pay naira packs (migration 202610210001), from the country header
# Cloudflare (cf-ipcountry) or Vercel (x-vercel-ip-country) adds. Locally there is none: PRICING_COUNTRY=NG shows naira.
# PRICING_COUNTRY=

# Cloudflare Turnstile on the sign-in and sign-up forms. The server checks each token with Cloudflare
# (lib/turnstile.ts); Supabase's own captcha setting stays off. Set both keys, or leave both empty locally
# to show the forms without the check. Cloudflare's test keys: site 1x00000000000000000000AA,
# secret 1x0000000000000000000000000000000AA (always pass).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Publishing (D-026). A long random string; the scheduler sends it as "Authorization: Bearer <CRON_SECRET>" to
#   POST <APP_URL>/api/cron/publish  every 15 minutes, and  POST <APP_URL>/api/cron/daily  once a day.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=
